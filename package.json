{
  "name": "open-typora",
  "version": "0.1.0",
  "description": "A free, open-source, local-first WYSIWYG Markdown editor. The community successor to Typora & MarkText.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-typora/open-typora"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "typora",
    "marktext",
    "note-taking"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.7.0",
    "katex": "^0.18.4",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.8.0",
    "vite": "^7.1.0"
  }
}
