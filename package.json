{
  "name": "inkstone",
  "version": "0.3.1",
  "description": "A free, open-source, local-first WYSIWYG Markdown editor inspired by Typora.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanXu2205/Inkstone"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "inkstone",
    "typora",
    "local-first"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "happy-dom": "^20.11.2",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "@tauri-apps/cli": "^2"
  }
}
